% chubuthesis.sty --- 修士論文テンプレート（LuaLaTeX）

% 例の Word→PDF 修論の体裁を参考に、表紙/要旨/目次/図表キャプション等を整えています。



\NeedsTeXFormat{LaTeX2e}

\ProvidesPackage{chubuthesis}[2025/12/15 Thesis style]



% --- 日本語（LuaLaTeX） ---

\RequirePackage{luatexja}
\RequirePackage{luatexja-fontspec}
\RequirePackage{fix-cm}

% --- Font setup ---
\setmainfont{Times New Roman}
\newcommand{\thesisbodyjfont}{MS PMincho}
\newjfontfamily{\thesisabstractjfont}{Yu Mincho}
\setmainjfont{\thesisbodyjfont}
\setsansjfont{MS PGothic}
% 本文の和文フォントは明朝体に統一
\renewcommand{\kanjifamilydefault}{\mcdefault}
\renewcommand{\kanjiseriesdefault}{\mddefault}

% --- Font sizes (pt) ---
\newcommand{\thesistitleyearfont}{\fontsize{16}{24}\selectfont}
\newcommand{\thesistitlefont}{\fontsize{18}{26}\selectfont}
\newcommand{\thesistitleotherfont}{\fontsize{16}{24}\selectfont}
\newcommand{\thesisabstractfont}{\fontsize{10.5}{16}\selectfont}
\newcommand{\thesistocfont}{\fontsize{12}{18}\selectfont}
\newcommand{\thesischapterfont}{\fontsize{16}{24}\selectfont}
\newcommand{\thesissectionfont}{\fontsize{14}{21}\selectfont}



% --- レイアウト ---



% master_thesis_cls.cls (4.3.2, 4.3.3項) に基づく設定



% 本文領域: 160mm x 232mm



% マージン: 25mm (左右)



\RequirePackage[
  a4paper,
  textheight=232mm,
  headheight=14.4pt,
  headsep=0.3in,
  footskip=30pt,
  left=25mm,
  right=25mm
]{geometry}

% --- 行間（master_thesis_cls.cls準拠：12pt/18pt） ---
\makeatletter
\renewcommand{\normalsize}{%
  \@setfontsize\normalsize\@xiipt{18}%
  \abovedisplayskip 16.5\p@ \@plus3\p@ \@minus7\p@
  \abovedisplayshortskip \z@ \@plus3\p@
  \belowdisplayshortskip 11\p@ \@plus3.5\p@ \@minus3\p@
  \belowdisplayskip \abovedisplayskip
  \let\@listi\@listI}
\normalsize
\renewcommand{\small}{%
  \@setfontsize\small\@xipt{13.6}%
  \abovedisplayskip 11\p@ \@plus3\p@ \@minus6\p@
  \abovedisplayshortskip \z@ \@plus3\p@
  \belowdisplayshortskip 6.5\p@ \@plus3.5\p@ \@minus3\p@
  \def\@listi{\leftmargin\leftmargini
              \topsep 9\p@ \@plus3\p@ \@minus5\p@
              \parsep 4.5\p@ \@plus2\p@ \@minus\p@
              \itemsep \parsep}%
  \belowdisplayskip \abovedisplayskip}
\renewcommand{\footnotesize}{%
  \@setfontsize\footnotesize\@xpt\@xiipt
  \abovedisplayskip 10\p@ \@plus2\p@ \@minus5\p@
  \abovedisplayshortskip \z@ \@plus3\p@
  \belowdisplayshortskip 6\p@ \@plus3\p@ \@minus3\p@
  \def\@listi{\leftmargin\leftmargini
              \topsep 6\p@ \@plus2\p@ \@minus2\p@
              \parsep 3\p@ \@plus2\p@ \@minus\p@
              \itemsep \parsep}%
  \belowdisplayskip \abovedisplayskip}
\renewcommand{\scriptsize}{\@setfontsize\scriptsize\@viiipt{9.5}}
\renewcommand{\tiny}{\@setfontsize\tiny\@vipt\@viipt}
\renewcommand{\large}{\@setfontsize\large\@xivpt{21}}
\renewcommand{\Large}{\@setfontsize\Large\@xviipt{25}}
\renewcommand{\LARGE}{\@setfontsize\LARGE\@xxpt{28}}
\renewcommand{\huge}{\@setfontsize\huge\@xxvpt{33}}
\let\Huge=\huge
\makeatother


% 段落字下げ（1全角）

% LuaLaTeXでは「zw」単位ではなく \zw を使う（luatexja）

\setlength{\parindent}{1\zw}

\setlength{\parskip}{0pt}



% 目次は section まで（節数を抑えて見通しを良くする）
\setcounter{tocdepth}{1}
\setcounter{secnumdepth}{2}

% 目次・図目次・表目次の表記
\renewcommand{\contentsname}{目 次}
\renewcommand{\listfigurename}{図 目 次}
\renewcommand{\listtablename}{表 目 次}
\renewcommand{\bibname}{参考文献参考URL}


% --- ページ番号（下右に統一） ---

\RequirePackage{fancyhdr}

\pagestyle{fancy}

\fancyhf{}

\fancyfoot[RO,RE]{\thepage}
\renewcommand{\headrulewidth}{0pt}

\renewcommand{\footrulewidth}{0pt}



% chapter開始ページなど plain も同じにする

\fancypagestyle{plain}{%
  \fancyhf{}%
  \fancyfoot[RO,RE]{\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}


% ltjsreport は章開始などで plainhead/plainfoot を使うため、こちらも同じにする

\fancypagestyle{plainhead}{%
  \fancyhf{}%
  \fancyfoot[RO,RE]{\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}
\fancypagestyle{plainfoot}{%
  \fancyhf{}%
  \fancyfoot[RO,RE]{\thepage}%
  \renewcommand{\headrulewidth}{0pt}%
  \renewcommand{\footrulewidth}{0pt}%
}


% --- 章見出し（中央・本文サイズ） ---
\makeatletter
\def\@makechapterhead#1{%
  % 章番号は全角数字（1～20まで）
  \def\fwchapnum{%
    \ifcase\value{chapter}\or
      \char"FF11\or\char"FF12\or\char"FF13\or\char"FF14\or\char"FF15\or
      \char"FF16\or\char"FF17\or\char"FF18\or\char"FF19\or
      \char"FF11\char"FF10\or
      \char"FF11\char"FF11\or\char"FF11\char"FF12\or\char"FF11\char"FF13\or
      \char"FF11\char"FF14\or\char"FF11\char"FF15\or\char"FF11\char"FF16\or
      \char"FF11\char"FF17\or\char"FF11\char"FF18\or\char"FF11\char"FF19\or
      \char"FF12\char"FF10%
    \else
      \number\value{chapter}%
    \fi
  }%
  \vspace*{\fill}%
  \begin{center}%
    {\normalfont\thesischapterfont 第\fwchapnum{}章\par}%
    \vspace{0.5\baselineskip}%
    {\normalfont\thesischapterfont #1\par}%
  \end{center}%
  \vspace*{\fill}%
  \clearpage
}
\def\@makeschapterhead#1{%
  \vspace*{\fill}%
  \begin{center}%
    {\normalfont\thesischapterfont #1\par}%
  \end{center}%
  \vspace*{\fill}%
  \clearpage
}
\makeatother

% --- Section heading size (14pt) ---
\makeatletter
\if@twocolumn
  \renewcommand{\section}{%
    \@startsection{section}{1}{\z@}%
    {0.6\Cvs}{0.4\Cvs}%
    {\normalfont\thesissectionfont\headfont\raggedright}}
\else
  \renewcommand{\section}{%
    \if@slide\clearpage\fi
    \@startsection{section}{1}{\z@}%
    {\Cvs \@plus.5\Cdp \@minus.2\Cdp}%
    {.5\Cvs \@plus.3\Cdp}%
    {\normalfont\thesissectionfont\headfont\raggedright}}
\fi
\makeatother


% --- 図表 ---

\RequirePackage{graphicx}

\RequirePackage{booktabs}

\RequirePackage{tabularx}

\RequirePackage{longtable}

\RequirePackage{array}



% --- 図だけのページ（float page）の縦方向センタリングをやめる ---

% デフォルトは \@fptop/\@fpbot が伸縮するため、図がページ中央に寄りやすい。

\makeatletter

\setlength{\@fptop}{0pt}

\setlength{\@fpsep}{8pt}

\setlength{\@fpbot}{0pt}

\makeatother



% --- 数式 ---

\RequirePackage{amsmath,amssymb}

\numberwithin{equation}{section}



% --- 単位 ---

\RequirePackage{siunitx}

\sisetup{detect-all}

\DeclareSIUnit{\decibelmilliwatt}{dBm}



% --- キャプション：図 4-1 タイトル / 表 4-1 タイトル ---
\makeatletter
\def\caption@documentclass{standard}
\makeatother
\RequirePackage[compatibility=false]{caption}

\renewcommand{\thefigure}{\thechapter.\arabic{figure}}
\renewcommand{\thetable}{\thechapter.\arabic{table}}
\captionsetup{labelsep=space}

\captionsetup[figure]{name=図,justification=centering}

\captionsetup[table]{name=表,justification=centering}


% --- 参照（図/表/式） ---

\newcommand{\figref}[1]{図~\ref{#1}}

\newcommand{\tabref}[1]{表~\ref{#1}}

\newcommand{\eqrefj}[1]{式(\ref{#1})}

\newcommand{\secref}[1]{\ref{#1}節}

\newcommand{\chapref}[1]{第\ref{#1}章}



% --- 章（番号なし）でも目次に載せる：はじめに / おわりに / 謝辞 ---

\newcommand{\chapterwithtoc}[2][]{%
  \chapter*{#2}%
  \if\relax\detokenize{#1}\relax
    \addcontentsline{toc}{chapter}{#2}%
  \else
    \addcontentsline{toc}{chapter}{#1}%
  \fi
}


% --- 参考文献（biblatex） ---

\RequirePackage[backend=biber,style=numeric,sorting=none,urldate=iso,seconds=true]{biblatex}
\renewcommand{\bibname}{参考文献参考URL}



% 参考文献の体裁：本文と同じ文字サイズ・行間に揃える

% （bbx/lbx 側で \bibfont 等が調整される場合があるため、開始フックで確実に上書きする）

\newlength{\thesisbodybaselineskip}

\AtBeginDocument{\setlength{\thesisbodybaselineskip}{\baselineskip}}

\AtBeginBibliography{%

  \normalfont\normalsize\selectfont

  \setlength{\baselineskip}{\thesisbodybaselineskip}%

  \setlength{\bibitemsep}{0pt}%

  \setlength{\bibparsep}{0pt}%

}

\renewcommand*{\bibfont}{\normalfont\normalsize}



% \scite{a,b} で [1][2] 形式を作る（普通の \cite は [1,2]）
\DeclareCiteCommand{\scite}
  {}
  {\mkbibbrackets{\usebibmacro{citeindex}\usebibmacro{cite}}}
  {}
  {}
% 行末禁則・和文欧文間グルーが \scite の直前で改行しないようにする
\makeatletter
\let\thesis@scite\scite
\renewcommand{\scite}{\unskip\thesis@scite}
\makeatother



% URL 表記を簡素化（"url:" / "visited on" を出さない）

\DeclareFieldFormat{url}{\url{#1}}
\DeclareFieldFormat{urldate}{参照日：#1}

\renewbibmacro*{url+urldate}{%
  \printfield{url}%
  \setunit{\addspace}%
  \printurldate%
}



% --- ハイパーリンク（最後の方で読み込み） ---

\RequirePackage[hidelinks]{hyperref}
\RequirePackage{bookmark}
% PDFしおりで数式系コマンドが警告にならないように無害化
\pdfstringdefDisableCommands{%
  \def\si#1{#1}%
  \def\SI#1#2{#1 #2}%
  \def\mathrm#1{#1}%
  \def\text#1{#1}%
  \def\hat#1{#1}%
  \def\bar#1{#1}%
  \def\fwchapnum{\number\value{chapter}}%
}


% --- 目次 ---

% numberless \chapter の「章扉（縦中央）」体裁を避け、目次の先頭余白を詰めて表示する

\makeatletter
\newcommand{\thesistableofcontents}{%
  \clearpage
  \thispagestyle{plain}%
  \pdfbookmark[0]{\contentsname}{toc}%
  \begingroup
  \thesistocfont
  % ltjsreport の \tableofcontents が行う幅計算をここでも実施

  % （これを省くと、章番号と見出しの間隔・インデントが崩れる）

  \settowidth\jsc@tocl@width{\headfont\prechaptername\postchaptername}%

  \settowidth\@tempdima{\headfont\appendixname}%

  \ifdim\jsc@tocl@width<\@tempdima

    \setlength\jsc@tocl@width{\@tempdima}%

  \fi

  \ifdim\jsc@tocl@width<2\zw

    \divide\jsc@tocl@width by 2

    \advance\jsc@tocl@width 1\zw

  \fi

  \begin{center}
    {\contentsname\par}
  \end{center}
  \vspace{1em}
  \@starttoc{toc}%
  \endgroup
  \clearpage
}
\makeatother

% --- 図目次・表目次 ---
\makeatletter
\newcommand{\thesislistoffigures}{%
  \clearpage
  \thispagestyle{plain}%
  \pdfbookmark[0]{\listfigurename}{lof}%
  \begin{center}
    {\Large \listfigurename\par}
  \end{center}
  \vspace{1em}
  \@starttoc{lof}%
  \clearpage
}
\newcommand{\thesislistoftables}{%
  \clearpage
  \thispagestyle{plain}%
  \pdfbookmark[0]{\listtablename}{lot}%
  \begin{center}
    {\Large \listtablename\par}
  \end{center}
  \vspace{1em}
  \@starttoc{lot}%
  \clearpage
}
\makeatother


% --- 参考文献 ---

% biblatex の heading=bibintoc は \chapter* を使うため、章扉の縦中央体裁が乗ってしまう。

% 参考文献は「本文ページ」として上寄せにする。

\newcommand{\thesisbibliography}[1]{%
  \clearpage
  \thispagestyle{plain}%
  \phantomsection
  \addcontentsline{toc}{chapter}{#1}%

  \pdfbookmark[0]{#1}{bibliography}%

  {\centering\Large #1\par}

  \vspace{0.75em}

  \printbibliography[heading=none]%

  \clearpage
}


% --- 表紙・要旨ページ ---

% meta.tex で定義するコマンドを使う想定



\newcommand{\makethesistitle}{%
\begin{titlepage}
  \thispagestyle{empty}
  \null\vfil
  \vskip -60pt
  \begin{center}
    {\vspace{-5em}\thesistitleyearfont \ThesisYearLabel\par}
    \vskip 3em%

    {\setlength{\fboxsep}{18pt}\fbox{%
      \begin{minipage}{\dimexpr\textwidth-2\fboxsep-2\fboxrule-6pt\relax}\centering
        {\thesistitlefont
          \if\relax\detokenize{\ThesisTitleLineTwo}\relax
            \ThesisTitleLineOne
          \else
            \ThesisTitleLineOne\\\ThesisTitleLineTwo
          \fi
          \par
        }
      \end{minipage}
    }}
    \vskip 2.0in%
    {\thesistitleotherfont \University\ \GraduateSchool\par\vskip 1.0em}
    {\thesistitleotherfont \Department\ \Course\par\vskip 1.0em}
    {\thesistitleotherfont \AuthorFamily\ \AuthorGiven\par}
    \vskip 2.0in%
    \begin{flushright}
      {\thesistitleotherfont
        \lineskip 4.75em%
        \begin{tabular}[t]{c}%
          {指導教授 \hspace{0.9em}\AdvisorFamily\ \AdvisorGiven}
        \end{tabular}\par}%
    \end{flushright}
    \vskip 8em%
  \end{center}\par
\end{titlepage}
}


\newcommand{\makeabstractpage}{%
\clearpage
\thispagestyle{empty}
\begingroup
\thesisabstractjfont
\thesisabstractfont
\noindent 修士論文題目

\vspace{0mm}
\noindent
\if\relax\detokenize{\ThesisTitleAbstract}\relax
  \if\relax\detokenize{\ThesisTitleLineTwo}\relax
    \ThesisTitleLineOne
  \else
    \ThesisTitleLineOne\\\ThesisTitleLineTwo
  \fi
\else
  \ThesisTitleAbstract
\fi
\par
% Space under thesis title on abstract page.
\vspace{0.4\baselineskip}
\noindent\rule{\linewidth}{0.4pt}\par

\vspace{0mm}
\centerline{\underline{\underline{情報工学}}専攻\hspace{2\zw}氏名\hspace{2\zw}\underline{\underline{\AuthorFamily\hspace{1\zw}\AuthorGiven}}}

\vspace{0mm}
\noindent 論\hspace{1\zw}文\hspace{1\zw}要\hspace{1\zw}旨\par
\vspace{0.2\baselineskip}
\noindent\hspace*{1\zw}\input{frontmatter/abstract}
\endgroup
\clearpage
}















